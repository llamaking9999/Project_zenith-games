pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
x = 56
y = 100
px = 0
py = 0

state = 1

end



-- check if a specific pixel coordinate (px, py) is solid
function is_solid(x, y, flg)
    local tx = flr(x / 8)
    local ty = flr(y / 8)
    local spr_num = mget(tx, ty)
    return fget(spr_num, flg)
end

function is_spooky(px, py)
    -- convert pixel coords to map tile coords (0 to 127)
    local mapd_x = flr(px / 8)
    local mapd_y = flr(py / 8)
    
    -- get the sprite number at that tile, then check if flag 0 is true
    local tile = mget(mapd_x, mapd_y)
    return fget(tile, 1)

end

function _update()

  
 cls()
 if (state == 0) then
 x = 56
 y = 100
 state = 1
 end
 //map and text
 
	//movement
	if (state == 1 or state == 2 or state == 3) then
	if (btn(0)) then
	x -= 1
	end
	if (btn(1)) then
	x += 1
	end
	if (btn(2)) then
	y -= 1
	end
	end
	if (state == 4) or (state == 5) or (state == 6) then
-- left (btn 0)
if (btn(0)) then
 if not is_solid(x-1, y, 2) and not is_solid(x-1, y+15, 2) then
  x -= 1
 end
end

-- right (btn 1)
if (btn(1)) then
 if not is_solid(x+16, y, 2) and not is_solid(x+16, y+15, 2) then
  x += 1
 end
end

-- up (btn 2)
if (btn(2)) then
 if not is_solid(x+8, y-1, 2) and not is_solid(x+15, y-1, 2) then
  y -= 1
 end
end

-- down (btn 3)
if (btn(3)) then
 if not is_solid(x+8, y+16, 2) and not is_solid(x+15, y+16, 2) then
  y += 1
 end
end
	end
	if (state == 1) then
	if (x < 12) then
	x = 12
	end
	if (x > 100) then
	x = 100
	end
	if (y < 20) then
	y = 20
	end
	end
	
	if (state == 2) then
	if (x+8 > 74) then
	x = 74-8
	end
	if (x+8 < 54) then
	x = 54-8
	end
	if (y < 20) then
	y = 20
	end
	end
	if (state == 3) then
	if (x+8 > 128+74) then
	x = 128+74-8
	end
	if (x+8 < 128+54) then
	x = 128+54-8
	end
	if (y < 20) then
	y = 20
	end
	
	end
	
	
	
	//check to move to next state
	if (state == 1 and y == 20 and x+8 < 74 and x > 54 ) then
	state = 2
	end
	
	if (state == 2 and btn(4)) then
	state = 3
	x += 128
	
	end
	if (state == 3 and btn(5)) then 

	state = 4
	x = 56 + 256
	y = 80
	end
	if (state == 999 and btn(4)) then
	state = 0
	end
	//check if spooky
	if (state == 4) or (state == 5) then
			if (is_solid(x,y,1) or is_solid(x+16,y,1) or is_solid(x+16,y+16,1) or is_solid(x,y+16,1)) then
				state = 999
				end
			if (is_solid(x,y,4) or is_solid(x+16,y,4) or is_solid(x+16,y+16,4) or is_solid(x,y+16,1)) then
				state = 6
				end
	end
	if (state == 4) then
	  if (x > 46*8-8) and (y > 4*8) and (y < 9*8) then
	  if (btn(4)) then
	  state = 5
	  y += 17 * 8
	  x -= 32 * 8
	  end
	end
	end
	if (state == 6) then
	  if (is_solid(x,y,4) or is_solid(x+16,y,4) or is_solid(x+16,y+16,4) or is_solid(x,y+16,1)) then
				if (btn(4)) then
			
	  
	  
	  x += 64 * 8
	  state = 7
	  end
	end
	
	end
end

function _draw()
if (state == 1) then
 map()
 camera(0,0)
 print("rappel up the building",20,115,6)
 line(64 - (64-x-8) * 0.5 ,0,x+8,y+8,6)
 end
if (state == 2) then
 map()
 camera(0,0)
 print("now break the barricade with a",4,115,6)
 line(64 - (64-x-8) * 0.5 ,0,x+8,y+8,6)
end
if (state == 3) then
 map()
 camera(128,0)
 print("nice, now enter with b",20+128,115,6)
 line(64+128 - (128+64-x-8) * 0.5 ,0,x+8,y+8,6)
end
if (state == 4) or (state == 5) then
 map()
 camera(x-64,y-64)
 print("make your way to the power switch",20+256,115,6)
 print("the rainbow dots are traps we've reconed",10+256,125,6)
 
end
if (state == 6) then
 map()
 camera(x-64,y-64)
 print("great, now press the button ♥",x-60,y+55,6)
 
end
if (state == 7) then
 map()
 camera(x-64,y-64)
 print("the end, also go play r6 vegas 2",x-60,y+55,6)
 
end
if (state == 999) then
 camera(1024, 1024)
 print("you dieds, press a to continue", 1024+6, 1024+64,8)
end
if (state < 4) then
spr(2,x,y,2,2)
end
if (state > 3) or (state == 5) then
spr(2,x,y,2,2)
end
  end

